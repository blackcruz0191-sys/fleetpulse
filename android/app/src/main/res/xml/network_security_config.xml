<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow plain HTTP only for local dev backend targets, not production traffic. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Host PC's Wi-Fi LAN IP, so a physical phone on the same network can reach the dev backend. -->
        <domain includeSubdomains="false">192.168.50.59</domain>
    </domain-config>
</network-security-config>
