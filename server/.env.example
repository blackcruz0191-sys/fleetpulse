# Postgres connection string for production/cloud hosting (e.g. from Neon, Supabase, Render Postgres).
# If unset, the server falls back to a local SQLite file at server/data/fleetpulse.db.
DATABASE_URL=

# Secret used to sign login session tokens (JWT). MUST be set to a long random value
# in production — anyone who knows it can forge valid login sessions.
JWT_SECRET=

# Port the server listens on. Render/most hosts set this automatically; only needed locally.
PORT=3000
